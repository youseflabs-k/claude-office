{
  "name": "cozy-office-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive 3D agent studio: React, Three.js, animated GLB characters and local workspace simulation.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check:assets": "node scripts/check-assets.mjs",
    "start": "node scripts/serve.mjs",
    "demo:server": "node examples/agent-server.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
